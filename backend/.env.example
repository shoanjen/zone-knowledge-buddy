# ===== zone-knowledge-buddy 后端配置（复制为 .env 后填写）=====

# 必填：Fernet 密钥（32 字节 url-safe base64）。生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KB_SECRET_KEY=

# 环境：dev 开启 CORS 与详细日志
KB_ENV=dev

# 首次启动初始化的单用户（初始化后改密需删 user 行重建，V1 无改密接口）
KB_ADMIN_USERNAME=admin
KB_ADMIN_PASSWORD=admin123

# 运行期数据目录（sqlite / chroma / storage）
KB_DATA_DIR=./data

# 向量固定通道（与生成供应商无关；一经建库锁定，见规格 §12.3）
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3

# 上传限制
KB_MAX_UPLOAD_MB=100
KB_MAX_UPLOAD_FILES=20

# dev 前端地址（CORS）
KB_CORS_ORIGIN=http://localhost:5173

# ---- 云端 GLM（生成主力）----
# 方式一：这里预填 key，首启后到设置页 activate cloud-glm 供应商
# 方式二：全部在设置页填写（推荐，key 加密落库）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6
